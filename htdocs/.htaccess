Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Paksa HTTPS (lewati untuk localhost).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Folder internal tidak boleh diakses langsung.
    RewriteRule ^(app|storage)(/|$) - [F,L]
    RewriteRule ^config(\.sample)?\.php$ - [F,L]

    # File statis yang ada dilayani langsung, sisanya ke index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

<FilesMatch "\.(json|sql|md)$">
    Require all denied
</FilesMatch>
